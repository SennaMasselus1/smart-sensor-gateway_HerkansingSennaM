    },
    {
        "id": "a1b2265d41e751c3",
        "type": "function",
        "z": "9ae6fae73b65c10d",
        "name": "Formatteer voor InfluxDB",
        "func": "// We gebruiken het label dat we in de vorige stap hebben toegevoegd\nif (msg.sensor_type === \"joystick\") {\n    msg.measurement = \"joystick_data\"; // De tabelnaam in InfluxDB\n    msg.payload = {\n        x: msg.payload.x,\n        y: msg.payload.y\n    };\n} else if (msg.sensor_type === \"knop\") {\n    msg.measurement = \"knop_data\"; // De tabelnaam in InfluxDB\n    msg.payload = {\n        status: msg.payload.status\n    };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 120,
        "wires": [
            [
                "56ad77b5d417e661",
                "c8e5e4014946a5eb"
            ]
        ]
