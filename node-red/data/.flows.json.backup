    {
        "id": "7cb6b48997d1d555",
        "type": "function",
        "z": "9ae6fae73b65c10d",
        "name": "Valideer Data",
        "func": "// Haal het topic en de data (payload) op\nlet topic = msg.topic;\nlet data = msg.payload;\n\n// 1. Controleer of het joystick data is\nif (topic === \"sensor/joystick\") {\n    // Validatie: x en y moeten tussen -100 en 100 liggen\n    if (data.x >= -100 && data.x <= 100 && data.y >= -100 && data.y <= 100) {\n        msg.sensor_type = \"joystick\"; // Handig label voor straks in de database\n        return msg; // De data is correct, stuur door!\n    } else {\n        node.warn(\"Foute joystick meting genegeerd!\");\n        return null; // Blokkeer de data\n    }\n}\n\n// 2. Controleer of het knop data is\nelse if (topic === \"sensor/knop\") {\n    // Validatie: status mag alleen 0 of 1 zijn\n    if (data.status === 0 || data.status === 1) {\n        msg.sensor_type = \"knop\"; \n        return msg; // De data is correct, stuur door!\n    } else {\n        node.warn(\"Foute knop meting genegeerd!\");\n        return null; // Blokkeer de data\n    }\n}\n\n// Blokkeer alle onbekende topics\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            [
                "a1b2265d41e751c3"
            ]
        ]
    },
    {
        "id": "c8e5e4014946a5eb",
        "type": "debug",
